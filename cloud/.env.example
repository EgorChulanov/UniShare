# ── UniShare cloud configuration ────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env file.

# Public HTTPS address of the app (Telegram and VK require HTTPS).
PUBLIC_URL=https://unishare.example.ru
# Domain for automatic HTTPS in docker-compose (Caddy). Usually PUBLIC_URL without https://
DOMAIN=unishare.example.ru

# Long random string: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# PostgreSQL. docker-compose fills this in automatically for the bundled database.
# For Yandex Managed PostgreSQL use its host and set DATABASE_SSL=true.
# DATABASE_URL=postgres://unishare:password@host:6432/unishare
# DATABASE_SSL=true

# ── Telegram ───────────────────────────────────────────────────────────────
# Token from @BotFather. Keep it secret; if it leaks press "Revoke" in BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=UniversalShareBot
# Optional: short name of a Mini App created with /newapp (t.me/<bot>/<name>).
TELEGRAM_APP_SHORT_NAME=
# Show the Telegram Login Widget on the website. Turn on only after BotFather
# /setdomain points at PUBLIC_URL's host, otherwise it says "Bot domain invalid".
TELEGRAM_LOGIN_WIDGET=false
# Random string, checked on every webhook call: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
# webhook (production) | polling (local) | off
TELEGRAM_BOT_MODE=webhook
# Optional Bot API relay if api.telegram.org is unreachable from the server.
TELEGRAM_API_ROOT=

# ── VK Mini App ────────────────────────────────────────────────────────────
# From vk.com/apps?act=manage → your app → Settings: ID and "Защищённый ключ".
VK_APP_ID=
VK_APP_SECRET=
# Optional notifications through a VK community (messages.send).
VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=

# ── Files ──────────────────────────────────────────────────────────────────
# local (disk volume) or s3 (Yandex Object Storage / any S3-compatible).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=unishare-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://storage.yandexcloud.net/unishare-media

# ── Optional ───────────────────────────────────────────────────────────────
# RAWG game catalog key (https://rawg.io/apidocs). Without it a built-in list is used.
RAWG_API_KEY=
SUPPORT_EMAIL=official@egorchulanov.ru

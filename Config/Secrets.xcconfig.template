// Copy to Secrets.xcconfig. Only publishable client configuration belongs here.
// In xcconfig, /$()/ expands to // without starting a comment.
SUPABASE_URL = https:/$()/PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY_HERE
SUPABASE_ANON_KEY = $(SUPABASE_PUBLISHABLE_KEY)

// Never add database passwords, service_role, sb_secret, RAWG or APNs secrets.
